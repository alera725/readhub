# Supabase
# URL del proyecto (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima/pública (Project Settings > API).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (uso exclusivo en servidor, nunca exponer al cliente).
# Requerida para persistir embeddings: la tabla article_embeddings tiene RLS
# sin políticas y solo se escribe con service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor de embeddings (RAG)
# Clave de API de OpenAI (uso exclusivo en servidor). Necesaria para generar
# embeddings con embedding.service.ts.
OPENAI_API_KEY=

# Opcional: sobrescribe el modelo de embeddings (por defecto text-embedding-3-small).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Secreto compartido del Database Webhook de indexación automática (fase 5).
# Debe coincidir con la cabecera x-webhook-secret configurada en supabase/webhooks.sql.
ARTICLE_WEBHOOK_SECRET=

# Proveedor conversacional (RAG, fase 8)
# Selector de proveedor de IA: "huggingface" (por defecto) o "anthropic".
# AI_PROVIDER=huggingface

# Hugging Face (proveedor por defecto). Token de acceso (uso exclusivo en
# servidor). El chat usa el router compatible con OpenAI.
HF_TOKEN=

# Opcional: sobrescribe el modelo (por defecto meta-llama/Llama-3.3-70B-Instruct).
# Se puede fijar un proveedor con sufijo, p. ej. ...Instruct:groq
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Proveedor alternativo (solo si AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
